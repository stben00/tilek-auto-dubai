# Telegram
BOT_TOKEN=
ADMIN_TELEGRAM_IDS=

# GitHub
GITHUB_TOKEN=
GITHUB_OWNER=stben00
GITHUB_REPO=tilek-auto-dubai
GITHUB_BRANCH=main
CARS_JSON_PATH=cars.json
IMAGES_FOLDER=assets/cars
VIDEOS_FOLDER=assets/videos

# AI (optional, leave empty to use regex parser only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google Gemini (получить бесплатно: https://aistudio.google.com/apikey)
# Используется для генерации рекламного постера — берёт ваше фото и добавляет дизайн
GEMINI_API_KEY=

# Website
WEBSITE_URL=https://stben00.github.io/tilek-auto-dubai/

# Video size limit in MB for GitHub upload (default 20)
MAX_VIDEO_MB=20

# -----------------------------------------------------------------------
# ПОСТЕР: настройки генерации рекламного изображения
# -----------------------------------------------------------------------

# DISABLE_POSTER: true = использовать только локальный Pillow-шаблон (без AI)
#                 false = включить AI-генерацию постера через Gemini/OpenAI
# Если GEMINI_API_KEY заполнен — ставьте false чтобы использовать ваши $300 кредиты
DISABLE_POSTER=false

# POSTER_MODE: auto   = Gemini сначала, при ошибке — локальный Pillow (рекомендуется)
#              ai     = только AI (Gemini/OpenAI), без Pillow fallback
#              local  = только локальный Pillow, без AI
POSTER_MODE=auto

# AI_PROVIDER: auto   = Gemini сначала, OpenAI fallback (рекомендуется)
#              gemini = только Gemini
#              openai = только OpenAI
AI_PROVIDER=gemini

# Local ad-poster generator (free, no API)
ENABLE_LOCAL_POSTER=true
POSTER_SIZE=1080x1350       # also try 1080x1920 for Stories

# AI features
ENABLE_AI_TEXT=true
ENABLE_AI_IMAGE=true

# Optional / placeholder for future
SITE_API_URL=
ADMIN_TELEGRAM_ID=
MEDIA_STORAGE_PATH=
